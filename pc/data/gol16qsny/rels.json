[
 {
  "id": "r1wec3sij",
  "a": "me",
  "b": "stdpi0x5",
  "kind": "신뢰",
  "note": "대표 대신 회사를 떠맡은 실장님을 가장 먼저 믿어 준 맏언니. 가을은 실장님의 건강까지 챙기려 든다.",
  "hist": [
   {
    "src": "프롤로그·1장",
    "text": "병원 복도에서 대표가 남긴 메모를 실장님에게 건넸다.",
    "at": 1793692187488
   }
  ],
  "src": "프롤로그·1장",
  "bn": "문가을",
  "at": 1793692187488
 },
 {
  "id": "rft0xpwax",
  "a": "me",
  "b": "0ri2udsj",
  "kind": "까칠한 신뢰",
  "note": "하린은 말끝마다 날을 세우지만 실장님의 판단만큼은 따르기로 했다.",
  "hist": [
   {
    "src": "프롤로그·1장",
    "text": "막차 플랫폼까지 실장님을 따라가 함께 백소하를 설득했다.",
    "at": 1793692187488
   }
  ],
  "src": "프롤로그·1장",
  "bn": "차하린",
  "at": 1793692187488
 },
 {
  "id": "rqzk0ysgq",
  "a": "me",
  "b": "y6j9cvqu",
  "kind": "첫 만남",
  "note": "소하에게 실장님은 자기 노래를 처음으로 끝까지 들어 준 사람이다.",
  "hist": [
   {
    "src": "프롤로그·1장",
    "text": "막차 플랫폼에서 처음 만나 새벽별 연습실로 데려왔다.",
    "at": 1793692187488
   }
  ],
  "src": "프롤로그·1장",
  "bn": "백소하",
  "at": 1793692187488
 },
 {
  "id": "r0q4y7pj1",
  "a": "me",
  "b": "qrxrhk4p",
  "kind": "탐색 중",
  "note": "지안은 실장님을 아직 다 믿지 않지만, 순위 그래프 앞에서 굳어 버린 표정을 놓치지 않았다.",
  "hist": [
   {
    "src": "프롤로그·1장",
    "text": "순위 발표 뒤 방송국 숫자에 대해 의미심장한 별톡을 보냈다.",
    "at": 1793692187488
   }
  ],
  "src": "프롤로그·1장",
  "bn": "서지안",
  "at": 1793692187488
 },
 {
  "id": "r3aijj3bu",
  "a": "me",
  "b": "7oxpev74",
  "kind": "막내와 실장",
  "note": "은별은 실장님을 졸졸 따르며 커피 대신 딸기우유를 내민다.",
  "hist": [
   {
    "src": "프롤로그·1장",
    "text": "밤샘 회의 중인 실장님의 네 번째 커피를 딸기우유로 바꿔 놓았다.",
    "at": 1793692187488
   }
  ],
  "src": "프롤로그·1장",
  "bn": "오은별",
  "at": 1793692187488
 },
 {
  "id": "r7z7xmpcx",
  "a": "0ri2udsj",
  "b": "y6j9cvqu",
  "kind": "엄격한 선배",
  "note": "하린은 소하의 생목 고음에 처음으로 감탄했고, 그만큼 혹독하게 연습시킨다.",
  "hist": [
   {
    "src": "프롤로그·1장",
    "text": "플랫폼에서 처음 만난 뒤 일주일 동안 한 번도 틀리지 않게 소하를 몰아붙였다.",
    "at": 1793692187488
   }
  ],
  "src": "프롤로그·1장",
  "an": "차하린",
  "bn": "백소하",
  "at": 1793692187488
 },
 {
  "id": "rle6f0apd",
  "a": "0ri2udsj",
  "b": "stdpi0x5",
  "kind": "센터와 리더",
  "note": "앞만 보고 달리는 하린을 가을이 뒤에서 붙잡는 사이. 서로를 인정하지만 자주 부딪친다.",
  "hist": [
   {
    "src": "프롤로그·1장",
    "text": "레벨 평가 심사평에 하린이 맞받아치자 가을이 진땀을 흘렸다.",
    "at": 1793692187488
   }
  ],
  "src": "프롤로그·1장",
  "an": "차하린",
  "bn": "문가을",
  "at": 1793692187488
 },
 {
